---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import CTA from '../../components/CTA';
import { Timer, Zap, MapPin, CheckCircle2 } from 'lucide-react';

const challenges = [
  "High demand volatility during peak hours and festive seasons.",
  "Requirement for ultra-fast last-mile delivery executives.",
  "High attrition rates typical of gig-economy roles.",
  "Need for localized presence and route expertise."
];

const solutions = [
  "On-demand scaling of delivery fleets within 24 hours.",
  "Local sourcing of candidates with deep route knowledge.",
  "Continuous pipeline of screened and verified riders.",
  "Integrated attendance and location tracking."
];
---

<Layout title="Quick Commerce Staffing Solutions | Skyward HR Service">
  <Header client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Quick Commerce <span class="text-primary">Staffing</span></h1>
      <p class="text-xl text-text-muted max-w-3xl mx-auto">
        Powering 10-minute deliveries with reliable, fast, and verified delivery executives. Scale your fleet instantly with Skyward.
      </p>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        <div class="p-10 bg-surface border border-surface-hover rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <Timer className="text-primary" /> Industry Challenges
          </h2>
          <div class="space-y-4">
            {challenges.map((c) => (
              <div class="flex items-start gap-3">
                <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 shrink-0" />
                <p class="text-text-muted">{c}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="p-10 bg-primary/5 border border-primary/20 rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <Zap className="text-primary" /> Skyward Solutions
          </h2>
          <div class="space-y-4">
            {solutions.map((s) => (
              <div class="flex items-start gap-3">
                <CheckCircle2 className="text-primary mt-0.5 shrink-0" size={18} />
                <p class="text-text-main">{s}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="bg-surface/30 py-24 border-y border-surface-hover mb-32">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-12">Key Roles for Quick Commerce</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {['Delivery Partners', 'Dark Store Pickers', 'Packers', 'Store Supervisors'].map((role) => (
            <div class="px-8 py-4 bg-surface border border-surface-hover rounded-2xl font-medium text-lg">
              {role}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <CTA client:visible />
    </div>
  </main>

  <Footer />
</Layout>
