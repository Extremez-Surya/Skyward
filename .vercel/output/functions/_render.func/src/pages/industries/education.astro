---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import CTA from '../../components/CTA';
import { GraduationCap, ShieldCheck, Users, CheckCircle2 } from 'lucide-react';

const challenges = [
  "Absolute requirement for child-safe and background-verified staff.",
  "Maintaining high hygiene standards in campus pantries and hostels.",
  "Need for disciplined and well-behaved support personnel.",
  "Managing seasonal breaks and holiday shift patterns."
];

const solutions = [
  "Rigorous multi-level background and police verification.",
  "Specialized training in campus etiquette and safety.",
  "On-call staff for school events, sports days, and functions.",
  "Uniformed staff to maintain campus discipline and identity."
];
---

<Layout title="Educational Institution Staffing | Skyward HR Service">
  <Header client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Educational <span class="text-primary">Institutions</span></h1>
      <p class="text-xl text-text-muted max-w-3xl mx-auto">
        Safe, verified, and professional support staff for schools, colleges, and universities. We prioritize safety and hygiene.
      </p>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        <div class="p-10 bg-surface border border-surface-hover rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <GraduationCap className="text-primary" /> Industry Challenges
          </h2>
          <div class="space-y-4">
            {challenges.map((c) => (
              <div class="flex items-start gap-3">
                <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 shrink-0" />
                <p class="text-text-muted">{c}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="p-10 bg-primary/5 border border-primary/20 rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <ShieldCheck className="text-primary" /> Skyward Solutions
          </h2>
          <div class="space-y-4">
            {solutions.map((s) => (
              <div class="flex items-start gap-3">
                <CheckCircle2 className="text-primary mt-0.5 shrink-0" size={18} />
                <p class="text-text-main">{s}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="bg-surface/30 py-24 border-y border-surface-hover mb-32">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-12">Key Roles for Education</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {['Office Assistants', 'Lab Helpers', 'Campus Guards', 'Housekeeping Staff', 'Pantry Support'].map((role) => (
            <div class="px-8 py-4 bg-surface border border-surface-hover rounded-2xl font-medium text-lg">
              {role}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <CTA client:visible />
    </div>
  </main>

  <Footer />
</Layout>
