---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Hero from '../components/Hero';
import TrustedCompanies from '../components/TrustedCompanies';
import WorkforceChallenges from '../components/WorkforceChallenges';
import Solutions from '../components/Solutions';
import ServicesOverview from '../components/ServicesOverview';
import AnalyticsSection from '../components/AnalyticsSection';
import Testimonials from '../components/Testimonials';
import CTA from '../components/CTA';
import Footer from '../components/Footer';

// FAQ placeholder component (will be updated later)
import FAQAccordion from '../components/FAQAccordion';
---

<Layout 
	title="Skyward HR | Professional Workforce Solutions for Serious Businesses"
	description="Skyward HR provides premium enterprise-grade workforce management, staffing solutions, and contract manpower services across India."
>
	<script type="application/ld+json" slot="head">
		{
			"@context": "https://schema.org",
			"@type": "Organization",
			"name": "Skyward HR Service",
			"url": "https://skywardhr.com",
			"logo": "https://skywardhr.com/logo.png",
			"sameAs": [
				"https://www.linkedin.com/company/skyward-hr",
				"https://twitter.com/skywardhr"
			],
			"contactPoint": {
				"@type": "ContactPoint",
				"telephone": "+91-XXXXXXXXXX",
				"contactType": "customer service"
			}
		}
	</script>
	<Header client:load />
	<main>
		<Hero client:load />
		<TrustedCompanies client:visible />
		<WorkforceChallenges client:visible />
		<Solutions client:visible />
		<ServicesOverview client:visible />
		<AnalyticsSection client:visible />
		<Testimonials client:visible />
		<FAQAccordion client:visible />
		<CTA client:visible />
	</main>
	<Footer />
</Layout>
