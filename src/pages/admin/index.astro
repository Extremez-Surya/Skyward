---
import DashboardLayout from '../../layouts/dashboards/DashboardLayout.astro';
import { getUserProfile } from '../../lib/user';
import { supabase } from '../../lib/supabase';
import AITools from '../../components/admin/AITools';
import AnalyticsChart from '../../components/AnalyticsChart';
import { Users, UserPlus, Briefcase, FileText, Zap } from 'lucide-react';
import { Button } from '../../components/ui/Button';

// Clerk auth is enforced by src/middleware.ts for /admin routes.
// So the page itself can safely derive the currently authenticated user id
// via the API route used elsewhere in the app.

const authResp = await fetch('/api/auth/me');

if (!authResp.ok) {
  return Astro.redirect('/sign-in');
}

const authJson = (await authResp.json()) as { userId?: string };
const userId = authJson.userId;

if (!userId) {
  return Astro.redirect('/sign-in');
}

const profile = await getUserProfile(userId);



if (!profile || profile.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

// Mock analytics data
const workforceData = [
  { label: 'Jan', value: 45 },
  { label: 'Feb', value: 52 },
  { label: 'Mar', value: 48 },
  { label: 'Apr', value: 61 },
  { label: 'May', value: 55 },
  { label: 'Jun', value: 67 },
];

const revenueData = [
  { label: 'Jan', value: 120 },
  { label: 'Feb', value: 145 },
  { label: 'Mar', value: 132 },
  { label: 'Apr', value: 178 },
  { label: 'May', value: 165 },
  { label: 'Jun', value: 210 },
];

// Fetch dynamic stats
const { count: activeWorkforce } = await supabase
  .from('deployments')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'active');

const { count: newCandidates } = await supabase
  .from('candidates')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'screening');

const { count: openRequirements } = await supabase
  .from('job_requirements')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'open');

const { count: pendingInvoices } = await supabase
  .from('invoices')
  .select('*', { count: 'exact', head: true })
  .eq('status', 'unpaid');

// Fetch recent deployments
const { data: recentDeployments } = await supabase
    .from('deployments')
    .select(`
        id,
        role,
        status,
        candidates:candidate_id (full_name),
        clients:client_id (company_name)
    `)
    .order('created_at', { ascending: false })
    .limit(5);

const stats = [
  { label: 'Active Workforce', value: activeWorkforce || 0, icon: Users, color: 'text-primary-600', bg: 'bg-primary-50' },
  { label: 'New Candidates', value: newCandidates || 0, icon: UserPlus, color: 'text-success', bg: 'bg-success/10', sub: 'Pending screening' },
  { label: 'Open Jobs', value: openRequirements || 0, icon: Briefcase, color: 'text-accent', bg: 'bg-accent/10' },
  { label: 'Unpaid Invoices', value: pendingInvoices || 0, icon: FileText, color: 'text-warning', bg: 'bg-warning/10' },
];
---

<DashboardLayout title="Admin Command Center">
  <div class="mb-10 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-text-primary tracking-tight">Command Center</h1>
      <p class="text-text-secondary font-medium">Skyward HR Operations Overview</p>
    </div>
    <div class="flex items-center gap-3">
      <Button variant="secondary" size="sm">Export Data</Button>
      <Button variant="primary" size="sm" rightIcon={Zap}>Quick Action</Button>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
    {stats.map((stat) => (
      <div class="p-6 bg-card border border-border rounded-2xl shadow-premium hover:shadow-lifted transition-all group">
        <div class="flex items-center gap-4 mb-4">
          <div class={`w-10 h-10 rounded-xl ${stat.bg} ${stat.color} flex items-center justify-center transition-transform group-hover:scale-110`}>
            <stat.icon size={20} />
          </div>
          <div class="text-sm font-bold text-text-muted uppercase tracking-widest">{stat.label}</div>
        </div>
        <div class="text-3xl font-bold text-text-primary">{stat.value}</div>
        {stat.sub && <div class="mt-2 text-[10px] font-bold text-success uppercase tracking-wider">{stat.sub}</div>}
      </div>
    ))}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
    <AnalyticsChart 
      client:visible 
      title="Deployment Growth" 
      data={workforceData} 
      color="bg-primary-600"
    />
    <AnalyticsChart 
      client:visible 
      title="Revenue Trend (₹)" 
      data={revenueData} 
      color="bg-accent"
      suffix="k"
    />
  </div>

  <div class="mb-12">
      <h2 class="text-xl font-bold text-text-primary mb-6 tracking-tight">Intelligent Workspace</h2>
      <AITools role={profile.role as any} client:load />
  </div>

  <div>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-text-primary tracking-tight">Recent Deployments</h2>
        <Button variant="ghost" size="sm">View All</Button>
      </div>
      <div class="bg-card border border-border rounded-2xl overflow-hidden shadow-premium">
          <table class="w-full text-left">
              <thead>
                  <tr class="border-b border-border bg-surface">
                      <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-text-muted">Candidate</th>
                      <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-text-muted">Client</th>
                      <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-text-muted">Role</th>
                      <th class="px-6 py-4 text-[10px] font-bold uppercase tracking-widest text-text-muted">Status</th>
                  </tr>
              </thead>
              <tbody class="divide-y divide-border">
                  {recentDeployments && recentDeployments.length > 0 ? recentDeployments.map((dep: any) => (
                      <tr class="hover:bg-primary-50/50 transition-colors">
                          <td class="px-6 py-5 text-sm font-bold text-text-primary">{dep.candidates?.full_name}</td>
                          <td class="px-6 py-5 text-sm font-medium text-text-secondary">{dep.clients?.company_name}</td>
                          <td class="px-6 py-5 text-sm font-medium text-text-secondary">{dep.role}</td>
                          <td class="px-6 py-5">
                              <span class={`px-3 py-1 text-[10px] font-bold uppercase tracking-widest rounded-full ${
                                  dep.status === 'active' ? 'bg-success/10 text-success' : 'bg-text-muted/10 text-text-muted'
                              }`}>
                                  {dep.status}
                              </span>
                          </td>
                      </tr>
                  )) : (
                      <tr>
                          <td colspan="4" class="px-6 py-16 text-center text-text-muted font-medium">No recent deployments found in the system.</td>
                      </tr>
                  )}
              </tbody>
          </table>
      </div>
  </div>
</DashboardLayout>
