---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header';
import Footer from '../components/Footer';
import CTA from '../components/CTA';
import { Truck, Box, ShoppingCart, Building2, GraduationCap, UtensilsCrossed, Users, Globe, Briefcase } from 'lucide-react';
import { Card, CardTitle, CardDescription } from '../components/ui/Card';

const industryList = [
  { name: 'Logistics', slug: 'logistics', icon: Truck, description: 'Scalable workforce solutions for rapid transportation and delivery operations.' },
  { name: 'Warehousing', slug: 'warehousing', icon: Box, description: 'Specialized staffing for high-density fulfillment centers and inventory management.' },
  { name: 'E-commerce', slug: 'e-commerce', icon: ShoppingCart, description: 'Agile manpower designed for peak online retail demand and rapid growth.' },
  { name: 'Retail Operations', slug: 'retail', icon: Users, description: 'Professional store helpers, customer support, and sales assistance teams.' },
  { name: 'Corporate Support', slug: 'corporate', icon: Building2, description: 'Enterprise-grade office support and administrative workforce solutions.' },
  { name: 'Quick Commerce', slug: 'quick-commerce', icon: Globe, description: 'Powering ultra-fast deliveries with specialized hub-and-spoke manpower.' },
  { name: 'Educational Hubs', slug: 'education', icon: GraduationCap, description: 'Safe, verified, and professional staff for modern campus operations.' },
  { name: 'Hospitality & Food', slug: 'food-services', icon: UtensilsCrossed, description: 'Hygienic and trained support teams for kitchens and premium dining.' },
  { name: 'SME Growth', slug: 'sme', icon: Briefcase, description: 'Flexible workforce management designed for rapidly growing small businesses.' }
];
---

<Layout 
  title="Industries We Serve | Skyward HR Service"
  description="Skyward HR provides specialized workforce solutions for logistics, retail, warehousing, and corporate enterprises across India."
>
	<Header client:load />
	<main class="relative pt-32 pb-20 bg-background overflow-hidden">
    {/* Background patterns */}
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, currentColor 1px, transparent 0); background-size: 40px 40px;"></div>
    <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary-600/5 blur-[120px] rounded-full pointer-events-none -translate-y-1/2 translate-x-1/4"></div>
    <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-primary-600/5 blur-[120px] rounded-full pointer-events-none translate-y-1/2 -translate-x-1/4"></div>

		<div class="container-custom relative z-10 mb-20">
      <div class="grid lg:grid-cols-2 gap-16 items-center">
        <div>
          <h1 class="text-5xl md:text-7xl font-bold text-text-primary mb-8 tracking-tight leading-[1.1]">Industries we <br/><span class="text-primary-600">empower.</span></h1>
          <p class="text-xl text-text-secondary max-w-2xl leading-relaxed font-medium mb-10">
            We provide tailored workforce ecosystems for mission-critical operations across India's most demanding sectors. Our expertise spans from ultra-fast quick commerce to massive-scale industrial warehousing.
          </p>
          
          <div class="flex flex-wrap gap-4">
            <div class="px-6 py-4 rounded-3xl bg-surface border border-border shadow-premium">
              <div class="text-3xl font-bold text-primary-600">500+</div>
              <div class="text-xs text-text-secondary font-bold uppercase tracking-wider">Client Locations</div>
            </div>
            <div class="px-6 py-4 rounded-3xl bg-surface border border-border shadow-premium">
              <div class="text-3xl font-bold text-primary-600">15+</div>
              <div class="text-xs text-text-secondary font-bold uppercase tracking-wider">Major Cities</div>
            </div>
            <div class="px-6 py-4 rounded-3xl bg-surface border border-border shadow-premium">
              <div class="text-3xl font-bold text-primary-600">24/7</div>
              <div class="text-xs text-text-secondary font-bold uppercase tracking-wider">Support Scale</div>
            </div>
          </div>
        </div>
        
        <div class="relative hidden lg:block">
          <div class="grid grid-cols-2 gap-4">
            <div class="space-y-4">
              <div class="h-48 rounded-[32px] bg-primary-600/10 border border-primary-600/20 flex items-center justify-center text-primary-600">
                <Truck size={48} />
              </div>
              <div class="h-64 rounded-[32px] bg-gradient-to-br from-primary-600/20 to-primary-600/5 border border-primary-600/20 flex items-center justify-center text-primary-600 shadow-premium">
                <Box size={48} />
              </div>
            </div>
            <div class="space-y-4 pt-12">
              <div class="h-64 rounded-[32px] bg-gradient-to-br from-accent/20 to-accent/5 border border-accent/20 flex items-center justify-center text-accent shadow-premium">
                <ShoppingCart size={48} />
              </div>
              <div class="h-48 rounded-[32px] bg-primary-600 flex items-center justify-center text-white">
                <Building2 size={48} />
              </div>
            </div>
          </div>
        </div>
      </div>
		</div>
		
    <div class="container-custom">
      <div class="flex items-center gap-4 mb-12">
        <h2 class="text-3xl font-bold text-text-primary">All Verticals</h2>
        <div class="h-px flex-grow bg-border"></div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {industryList.map((industry) => (
          <a href={`/industries/${industry.slug}`} class="group">
            <Card client:visible variant="feature" className="h-full bg-surface border-transparent hover:border-primary-100 flex flex-col items-start transition-all p-7">
              <div class="w-12 h-12 bg-card rounded-2xl flex items-center justify-center text-primary-600 mb-6 shadow-premium group-hover:bg-primary-600 group-hover:text-white transition-all duration-300">
                <industry.icon size={24} />
              </div>
              <CardTitle className="mb-3 text-xl group-hover:text-primary-600 transition-colors">{industry.name}</CardTitle>
              <CardDescription className="flex-grow mb-6 text-base">{industry.description}</CardDescription>
              <div class="flex items-center text-sm font-bold text-primary-600 group-hover:gap-2 transition-all">
                View Solutions 
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="ml-1">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </div>
            </Card>
          </a>
        ))}
      </div>
    </div>
	</main>
	<CTA client:visible />
	<Footer />
</Layout>
