---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import CTA from '../../components/CTA';
import { MapPin, CheckCircle2, Building2, Users } from 'lucide-react';

export const prerender = true;

export function getStaticPaths() {
  const cities = [
    { city: "delhi", name: "Delhi", region: "NCR" },
    { city: "gurgaon", name: "Gurgaon", region: "Haryana" },
    { city: "noida", name: "Noida", region: "Uttar Pradesh" },
    { city: "faridabad", name: "Faridabad", region: "Haryana" },
    { city: "ghaziabad", name: "Ghaziabad", region: "Uttar Pradesh" }
  ];
  return cities.map(({ city, name, region }) => ({
    params: { city },
    props: { name, region }
  }));
}

const { city } = Astro.params;
const { name, region } = Astro.props;

const title = `Manpower Supply Company in ${name} | Staffing Agency | Skyward HR`;
const description = `Skyward HR is a leading manpower supply company in ${name}. We provide verified warehouse staffing, logistics manpower, and contract staffing services in ${name} ${region}.`;

const localServices = [
  "Warehouse & Logistics Staffing",
  "Delivery Fleet Management",
  "Housekeeping & Facility Support",
  "Contractual Manpower Solutions"
];
---

<Layout title={title} description={description}>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": `Skyward HR Service - ${name}`,
      "address": {
        "@type": "PostalAddress",
        "addressLocality": name,
        "addressRegion": region,
        "addressCountry": "IN"
      },
      "url": `https://skywardhr.com/locations/${city}`,
      "telephone": "+91-XXXXXXXXXX",
      "priceRange": "$$"
    }
  </script>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": `What services does Skyward HR provide in ${name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `In ${name}, Skyward HR provides comprehensive manpower supply services including warehouse staffing, logistics manpower, delivery executives, and facility support staff.`
          }
        },
        {
          "@type": "Question",
          "name": `How quickly can Skyward HR deploy staff in ${name}?`,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": `We specialize in rapid deployment, often providing verified manpower within 24-48 hours depending on the specific requirements in ${name}.`
          }
        }
      ]
    }
  </script>
  <Header client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Manpower Supply in <span class="text-primary">{name}</span></h1>
      <p class="text-xl text-text-muted max-w-3xl mx-auto">
        Your trusted partner for reliable workforce management and staffing solutions across {name} and {region}.
      </p>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6">Staffing Solutions for {name} Businesses</h2>
          <p class="text-lg text-text-muted mb-8 leading-relaxed">
            As a premier staffing company in {name}, Skyward HR understands the unique demands of the local market. We specialize in rapid deployment of verified manpower for warehouses, logistics hubs, and retail operations.
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {localServices.map((service) => (
              <div class="flex items-center gap-3 p-4 bg-surface border border-surface-hover rounded-xl">
                <CheckCircle2 size={18} className="text-primary shrink-0" />
                <span class="font-medium">{service}</span>
              </div>
            ))}
          </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-8 bg-surface border border-surface-hover rounded-2xl text-center">
            <Building2 className="w-10 h-10 text-primary mx-auto mb-4" />
            <h3 class="text-2xl font-bold mb-1">50+</h3>
            <p class="text-text-muted">Local Clients</p>
          </div>
          <div class="p-8 bg-primary/10 border border-primary/30 rounded-2xl text-center mt-8">
            <Users className="w-10 h-10 text-primary mx-auto mb-4" />
            <h3 class="text-2xl font-bold mb-1">2000+</h3>
            <p class="text-text-muted">Deployed Staff</p>
          </div>
        </div>
      </div>
    </div>

    {/* FAQ Section */}
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <h2 class="text-3xl font-bold mb-12 text-center">Frequently Asked Questions</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        <div class="p-6 bg-surface border border-surface-hover rounded-2xl">
          <h3 class="text-xl font-bold mb-3">What services does Skyward HR provide in {name}?</h3>
          <p class="text-text-muted">In {name}, Skyward HR provides comprehensive manpower supply services including warehouse staffing, logistics manpower, delivery executives, and facility support staff.</p>
        </div>
        <div class="p-6 bg-surface border border-surface-hover rounded-2xl">
          <h3 class="text-xl font-bold mb-3">How quickly can Skyward HR deploy staff in {name}?</h3>
          <p class="text-text-muted">We specialize in rapid deployment, often providing verified manpower within 24-48 hours depending on the specific requirements in {name}.</p>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <CTA client:visible />
    </div>
  </main>

  <Footer />
</Layout>
