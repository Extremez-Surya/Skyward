---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import CTA from '../../components/CTA';
import { Store, Users, ShoppingBag, CheckCircle2 } from 'lucide-react';

const challenges = [
  "High attrition and training costs for store staff.",
  "Managing staffing levels for weekend rushes and promotions.",
  "Requirement for groomed and customer-friendly personnel.",
  "Ensuring punctuality and attendance in multi-location stores."
];

const solutions = [
  "Continuous sourcing and grooming of retail-ready staff.",
  "Flexible 'on-call' workforce models for peak periods.",
  "Professional background verification and credential checks.",
  "Automated attendance tracking via the Skyward mobile portal."
];
---

<Layout title="Retail Industry Staffing | Skyward HR Service">
  <Header client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Retail <span class="text-primary">Industry</span></h1>
      <p class="text-xl text-text-muted max-w-3xl mx-auto">
        Powering retail excellence with professional and verified manpower. We provide the staff that represents your brand on the shop floor.
      </p>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        <div class="p-10 bg-surface border border-surface-hover rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <Store className="text-primary" /> Industry Challenges
          </h2>
          <div class="space-y-4">
            {challenges.map((c) => (
              <div class="flex items-start gap-3">
                <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 shrink-0" />
                <p class="text-text-muted">{c}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="p-10 bg-primary/5 border border-primary/20 rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <ShoppingBag className="text-primary" /> Skyward Solutions
          </h2>
          <div class="space-y-4">
            {solutions.map((s) => (
              <div class="flex items-start gap-3">
                <CheckCircle2 className="text-primary mt-0.5 shrink-0" size={18} />
                <p class="text-text-main">{s}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="bg-surface/30 py-24 border-y border-surface-hover mb-32">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-12">Key Roles for Retail</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {['Store Helpers', 'Billing Executives', 'Sales Promoters', 'Inventory Clerks', 'Store Coordinators'].map((role) => (
            <div class="px-8 py-4 bg-surface border border-surface-hover rounded-2xl font-medium text-lg">
              {role}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <CTA client:visible />
    </div>
  </main>

  <Footer />
</Layout>
