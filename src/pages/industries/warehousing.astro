---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import CTA from '../../components/CTA';
import { Box, ShieldCheck, BarChart3, CheckCircle2 } from 'lucide-react';

const challenges = [
  "Large-scale recruitment needs for regional distribution centers.",
  "Requirement for staff trained in warehouse management systems (WMS).",
  "Ensuring safety compliance and reducing workplace incidents.",
  "Managing seasonal shifts in inventory movement."
];

const solutions = [
  "Bulk hiring capabilities for rapid facility ramp-ups.",
  "Initial training on safety protocols and inventory tools.",
  "On-site coordinators for large-scale workforce management.",
  "Real-time attendance reporting for optimized shift planning."
];
---

<Layout 
  title="Warehouse & Distribution Center Staffing | Skyward HR"
  description="Optimize your supply chain with Skyward HR. We provide bulk hiring, safety training, and on-site workforce management for warehouses and distribution centers."
>
  <script type="application/ld+json" slot="head">
    {
      "@context": "https://schema.org",
      "@type": "Service",
      "name": "Warehouse Staffing Solutions",
      "provider": {
        "@type": "Organization",
        "name": "Skyward HR Service"
      },
      "description": "Specialized staffing for regional distribution centers, dark stores, and warehouse facilities across India.",
      "areaServed": {
        "@type": "Country",
        "name": "India"
      }
    }
  </script>
  <Header client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Warehousing <span class="text-primary">Staffing</span></h1>
      <p class="text-xl text-text-muted max-w-3xl mx-auto">
        Supporting your supply chain with reliable, trained, and safe warehouse manpower. From regional hubs to dark stores.
      </p>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        <div class="p-10 bg-surface border border-surface-hover rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <Box className="text-primary" /> Industry Challenges
          </h2>
          <div class="space-y-4">
            {challenges.map((c) => (
              <div class="flex items-start gap-3">
                <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 shrink-0" />
                <p class="text-text-muted">{c}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="p-10 bg-primary/5 border border-primary/20 rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <ShieldCheck className="text-primary" /> Skyward Solutions
          </h2>
          <div class="space-y-4">
            {solutions.map((s) => (
              <div class="flex items-start gap-3">
                <CheckCircle2 className="text-primary mt-0.5 shrink-0" size={18} />
                <p class="text-text-main">{s}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="bg-surface/30 py-24 border-y border-surface-hover mb-32">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-12">Key Roles for Warehousing</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {['Pickers', 'Packers', 'Loaders & Unloaders', 'Inventory Assistants', 'Warehouse Supervisors'].map((role) => (
            <div class="px-8 py-4 bg-surface border border-surface-hover rounded-2xl font-medium text-lg">
              {role}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <CTA client:visible />
    </div>
  </main>

  <Footer />
</Layout>
