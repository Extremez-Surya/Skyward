---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import CTA from '../../components/CTA';
import { UserPlus, Wallet, BarChart2, CheckCircle2 } from 'lucide-react';

const challenges = [
  "Difficulty in managing small teams with high administrative overhead.",
  "Lack of specialized HR support for recruitment and compliance.",
  "Need for flexible manpower to handle business growth spurts.",
  "High impact of even a single staff vacancy on daily operations."
];

const solutions = [
  "End-to-end workforce management for even 1-2 workers.",
  "Zero administrative burden with automated payroll and compliance.",
  "Access to a wide pool of pre-screened local candidates.",
  "Dedicated support for rapid replacements and query resolution."
];
---

<Layout title="SME Workforce Solutions | Skyward HR Service">
  <Header client:load />
  
  <main class="pt-32 pb-20">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-20 text-center">
      <h1 class="text-4xl md:text-6xl font-bold mb-6 tracking-tight">Small & Medium <span class="text-primary">Enterprises</span></h1>
      <p class="text-xl text-text-muted max-w-3xl mx-auto">
        Empowering SMEs with professional workforce management. We handle the HR, so you can focus on growing your business.
      </p>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
        <div class="p-10 bg-surface border border-surface-hover rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <UserPlus className="text-primary" /> Industry Challenges
          </h2>
          <div class="space-y-4">
            {challenges.map((c) => (
              <div class="flex items-start gap-3">
                <div class="mt-1.5 w-1.5 h-1.5 rounded-full bg-red-500 shrink-0" />
                <p class="text-text-muted">{c}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="p-10 bg-primary/5 border border-primary/20 rounded-3xl">
          <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
            <Wallet className="text-primary" /> Skyward Solutions
          </h2>
          <div class="space-y-4">
            {solutions.map((s) => (
              <div class="flex items-start gap-3">
                <CheckCircle2 className="text-primary mt-0.5 shrink-0" size={18} />
                <p class="text-text-main">{s}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="bg-surface/30 py-24 border-y border-surface-hover mb-32">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl font-bold mb-12">Key Roles for SMEs</h2>
        <div class="flex flex-wrap justify-center gap-4">
          {['Office Assistants', 'Delivery Runners', 'Sales Helpers', 'Store Support', 'General Utility'].map((role) => (
            <div class="px-8 py-4 bg-surface border border-surface-hover rounded-2xl font-medium text-lg">
              {role}
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <CTA client:visible />
    </div>
  </main>

  <Footer />
</Layout>
