---
import DashboardLayout from '../../layouts/dashboards/DashboardLayout.astro';
import { getCandidateProfile } from '../../lib/user';
import CandidateDocumentUpload from '../../components/candidate/CandidateDocumentUpload';

const { userId } = Astro.locals.auth();

if (!userId) {
  return Astro.redirect('/sign-in');
}

const profile = await getCandidateProfile(userId);

if (!profile) {
  return Astro.redirect('/dashboard');
}
---

<DashboardLayout title="Documents" role="candidate">
    <div class="max-w-4xl mx-auto">
        <div class="mb-8">
            <h1 class="text-2xl font-bold text-text-main mb-2">Document Verification</h1>
            <p class="text-text-muted">Please upload clear copies of your documents for verification.</p>
        </div>

        <CandidateDocumentUpload candidateId={profile.id} client:load />

        <div class="mt-8 p-6 bg-blue-500/5 border border-blue-500/20 rounded-2xl">
            <h3 class="text-sm font-semibold text-primary mb-2">Why is this required?</h3>
            <p class="text-xs text-text-muted leading-relaxed">
                As per labor regulations and company policy, we require verified identification for all deployed workforce. 
                Your documents are securely stored and used only for compliance and verification purposes.
            </p>
        </div>
    </div>
</DashboardLayout>
