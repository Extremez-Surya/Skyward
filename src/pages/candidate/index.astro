---
import DashboardLayout from '../../layouts/dashboards/DashboardLayout.astro';
import { getUserProfile } from '../../lib/user';
import { supabase } from '../../lib/supabase';
import CandidateDocumentUpload from '../../components/candidate/CandidateDocumentUpload';
import { ShieldCheck, CheckCircle2, Clock, UploadCloud } from 'lucide-react';
import { Card, CardTitle, CardDescription } from '../../components/ui/Card';

const { userId } = (Astro.locals as any).auth();

if (!userId) {
  return Astro.redirect('/sign-in');
}

const profile = await getUserProfile(userId);

if (!profile || (profile.role !== 'candidate' && profile.role !== 'admin' && profile.role !== 'manager')) {
  return Astro.redirect('/dashboard');
}

// Fetch candidate record
const { data: candidate } = await supabase
  .from('candidates')
  .select('id, status')
  .eq('user_id', profile.id)
  .single();

const stages = [
  { label: 'Profile Completed', status: 'completed' },
  { label: 'Document Verification', status: 'in-progress' },
  { label: 'Deployment Interview', status: 'pending' },
];
---

<DashboardLayout title="Candidate Portal">
  <div class="mb-10">
    <h1 class="text-3xl font-bold text-text-primary tracking-tight text-balance">Candidate Portal</h1>
    <p class="text-text-secondary font-medium">Manage your profile and track deployment status.</p>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <div class="lg:col-span-5">
      <Card client:load className="h-full bg-white border-border shadow-premium p-8">
        <div class="flex items-center gap-4 mb-8">
          <div class="w-14 h-14 rounded-2xl bg-primary-50 flex items-center justify-center text-primary-600">
            <ShieldCheck size={28} />
          </div>
          <div>
            <div class="text-sm font-bold text-text-muted uppercase tracking-widest">Application Status</div>
            <div class="text-xl font-bold text-text-primary">{candidate?.status || 'Screening'}</div>
          </div>
        </div>

        <div class="space-y-6 relative">
          {/* Vertical Line */}
          <div class="absolute top-2 bottom-2 w-0.5 bg-border z-0" style="left: 11px;" />
          
          {stages.map((stage) => (
            <div class="flex items-center gap-4 relative z-10">
              <div class={`w-6 h-6 rounded-full border-4 border-white shadow-sm flex items-center justify-center ${
                stage.status === 'completed' ? 'bg-success text-white' : 
                stage.status === 'in-progress' ? 'bg-primary-600 animate-pulse' : 'bg-border'
              }`}>
                {stage.status === 'completed' && <CheckCircle2 size={12} />}
              </div>
              <div>
                <div class={`text-sm font-bold ${stage.status === 'pending' ? 'text-text-muted' : 'text-text-primary'}`}>
                  {stage.label}
                </div>
                {stage.status === 'in-progress' && <div class="text-[10px] font-bold text-primary-600 uppercase tracking-widest mt-0.5">Awaiting Review</div>}
              </div>
            </div>
          ))}
        </div>
      </Card>
    </div>

    <div class="lg:col-span-7">
      <Card client:load className="h-full bg-card border-border shadow-premium p-8">
        <div class="flex items-center gap-3 mb-8">
          <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-600">
            <UploadCloud size={20} />
          </div>
          <CardTitle>Required Documents</CardTitle>
        </div>
        
        {candidate ? (
          <CandidateDocumentUpload candidateId={candidate.id} client:load />
        ) : (
          <div class="p-12 text-center bg-surface border border-dashed border-border rounded-2xl">
            <p class="text-text-muted font-medium italic">No candidate record found. Please contact support if this is an error.</p>
          </div>
        )}
      </Card>
    </div>
  </div>
</DashboardLayout>
